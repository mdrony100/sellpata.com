APP_NAME=SellPata
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- SellPata marketing site -------------------------------------------
# Tutorial video. Leave empty to show the Bengali placeholder.
SELLPATA_YOUTUBE_URL=
# Example: ৫০০+ রেডমেড ল্যান্ডিং পেজ (only once inventory is confirmed)
SELLPATA_TEMPLATE_COUNT_LABEL=
# Feature availability. Keep false until the integration actually works.
# Online payment buttons stay hidden unless AVAILABLE is true AND both driver and key are set.
SELLPATA_PAYMENTS_AVAILABLE=false
SELLPATA_PAYMENT_DRIVER=
SELLPATA_PAYMENT_KEY=
SELLPATA_SHIPPING_AVAILABLE=false
# Optional real contact details; hidden when empty.
SELLPATA_CONTACT_PHONE=
SELLPATA_CONTACT_EMAIL=
SELLPATA_CONTACT_WHATSAPP=

# Marketing site content (also editable in /admin)
ADMIN_EMAIL=admin@sellpata.com
ADMIN_PASSWORD=change-me-before-seeding

# Shows the generated OTP on screen until a real SMS provider is wired up.
# Forced off in production regardless of this value.
OTP_EXPOSE_TEST_CODE=true
OTP_DRIVER=log

# Storefront hostnames are {username}.PLATFORM_BASE_DOMAIN.
PLATFORM_BASE_DOMAIN=sellpata.com
# A record customers create when connecting their own domain. Shown in the dashboard.
PLATFORM_SERVER_IP=169.58.90.98
